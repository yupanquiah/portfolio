---
import Head from "@components/Head.astro";
import MenuModal from "@components/MenuModal.astro";
import Footer from "@sections/Footer.astro";
import Header from "@sections/Header.astro";

import "@styles/global.css";

const { lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <Head name="Humberto Yupanqui Apaza" />
  <body>
    <div
      class="font-n27 h-full min-h-dvh w-full bg-slate-50 text-slate-950 dark:bg-slate-950 dark:text-slate-50"
    >
    <Header />
      <main class:list={Astro.props.class}>
        <slot />
      </main>
      <Footer />
    </div>
    <MenuModal />
  </body>
</html>

<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.documentElement;
    const themeToggle = document.getElementById(
      "theme-toggle",
    ) as HTMLButtonElement;
    const turnTheme = document.getElementById(
      "turn-theme",
    ) as HTMLButtonElement;

    if (!themeToggle || !turnTheme) return;

    const updateButtonText = () => {
      const currentTheme = root.getAttribute("data-theme");

      if (currentTheme === "dark") {
        turnTheme.textContent = "Activar el modo claro";
      } else {
        turnTheme.textContent = "Activar el modo oscuro";
      }
    };

    const applyTheme = () => {
      const isDark =
        localStorage.theme === "dark" ||
        !(
          "theme" in localStorage &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
        );
      root.setAttribute("data-theme", isDark ? "dark" : "light");
      localStorage.theme = isDark ? "dark" : "light";

      updateButtonText();
    };

    const changeTheme = () => {
      const isDarkMode = root.getAttribute("data-theme") === "dark";
      root.setAttribute("data-theme", isDarkMode ? "light" : "dark");
      localStorage.theme = isDarkMode ? "light" : "dark";

      updateButtonText();
    };

    themeToggle.addEventListener("click", changeTheme);
    turnTheme.addEventListener("click", changeTheme);

    applyTheme();
  });
</script>
