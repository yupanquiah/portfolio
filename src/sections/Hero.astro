---
import Section from "@components/Section.astro";
---

<div
  class="w-full border-b border-slate-200 px-0 sm:px-14 dark:border-slate-600"
>
  <Section class="justify-center py-20">
    <div class="flex flex-col items-center space-y-8">
      <span class="font-monaspace-neon text-[10px] font-extralight opacity-50"
        >Bienvenido a mi sitio.</span
      >
      <h1 class="font-geist text-center text-5xl font-bold text-balance">
        Soy Humberto Yupanqui, <br /> Desarrollador web.
      </h1>
      <p class="max-w-xl text-center text-lg text-balance opacity-70">
        Desarrollador Web & Técnico en Ingeniería de Software con Inteligencia
        Artificial.
      </p>
    </div>
  </Section>
</div>
