---
import Card from "@components/Card.astro";
import CodeTag from "@components/CodeTag.astro";
import Section from "@components/Section.astro";
import SectionNumber from "@components/SectionNumber.astro";

import ArrowNarrowRight from "@icons/arrow-narrow-right.svg";

import { PROJECTS } from "@data/projects";
---

<div
  id="projects"
  class="w-full border-b border-slate-200 px-0 sm:px-14 dark:border-slate-900"
>
  <Section class="relative px-10 py-8 pt-20">
    <SectionNumber number="02" />
    <CodeTag tag="projects.ts" />
    <h2 class="font-geist text-2xl font-bold text-balance">Proyectos</h2>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROJECTS.map(
          ({
            title,
            description,
            image,
            technologies,
            repository,
            link,
            alt,
            year,
          }) => (
            <Card
              title={title}
              description={description}
              image={image}
              technologies={technologies}
              repository={repository}
              link={link}
              alt={alt}
              year={year}
            />
          ),
        )
      }
    </div>
    <a
      href="/projects"
      class="group mt-4 inline-flex items-center justify-end gap-1 text-sm font-light opacity-70 transition-opacity duration-300 hover:opacity-100"
    >
      Ver mas proyectos <ArrowNarrowRight
        class="group-hover:translate-x-0.5 group-hover:transition-all group-hover:duration-300"
      />
    </a>
  </Section>
</div>
