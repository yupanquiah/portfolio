---
import CodeTag from "@components/CodeTag.astro";
import Section from "@components/Section.astro";
import SectionNumber from "@components/SectionNumber.astro";
import Timeline from "@components/Timeline.astro";

import { EXPERIENCES } from "@data/experiences";
---

<div
  class="w-full border-b border-slate-200 px-0 sm:px-14 dark:border-slate-900"
>
  <Section class="relative px-10 py-8 pt-20">
    <SectionNumber number="01" />
    <CodeTag tag="experiencies.ts" />
    <h2 class="font-geist text-2xl font-bold text-balance">Experiencia</h2>
    <p>
      Desarrollador web con experiencia en la creación de aplicaciones y sitios
      web.
    </p>
    <div class="space-y-4 py-8 md:space-y-8">
      {
        EXPERIENCES.map(
          ({
            title,
            company,
            location,
            startDate,
            endDate,
            responsibilities,
          }) => (
            <Timeline
              title={title}
              company={company}
              location={location}
              startDate={startDate}
              endDate={endDate}
              responsibilities={responsibilities}
            />
          ),
        )
      }
    </div>
  </Section>
</div>
