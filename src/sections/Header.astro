---
import Backdrop from "@components/Backdrop.astro";
import Section from "@components/Section.astro";

import Logo from "@assets/astro.svg";
import Menu from "@icons/menu.svg";
import Moon from "@icons/moon.svg";
import Sun from "@icons/sun.svg";

interface Props {
  title: string;
  href: string;
}

const NAV_ITEMS: Props[] = [
  { title: "Home", href: "/" },
  { title: "About", href: "#about" },
  { title: "Projects", href: "#projects" },
  { title: "Contact", href: "#contact" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full border-b border-slate-200 bg-slate-50/60 backdrop-blur-lg dark:border-slate-600 dark:bg-slate-950/60"
>
  <Backdrop />
  <Section class="flex-row items-center justify-between py-2">
    <Logo />
    <nav class="flex items-center gap-2">
      <ul id="menu" class="flex items-center">
        {
          NAV_ITEMS.map(({ title, href }) => (
            <li>
              <a
                class={`px-3 py-2 text-sm font-normal opacity-50 transition-opacity duration-200 hover:opacity-100 ${currentPath === href ? "opacity-100" : ""}`}
                href={href}
              >
                {title}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-1">
        <button
          id="theme-toggle"
          class="cursor-pointer rounded-md border border-slate-400 p-1.5 transition-opacity duration-200 hover:bg-black/5 hover:opacity-100 dark:border-slate-400/60 dark:hover:bg-white/15"
          name="toggle theme"
          type="button"
        >
          <Sun class="hidden h-3.5 w-3.5 opacity-50 dark:block" />
          <Moon class="block h-3.5 w-3.5 opacity-50 dark:hidden" />
        </button>
        <button
          id="menu-toggle"
          class="h-full cursor-pointer rounded-md border border-slate-400 p-1.5 transition-opacity duration-200 hover:bg-black/5 hover:opacity-100 md:hidden dark:border-slate-400/60 dark:hover:bg-white/15"
          name="toggle menu"
          type="button"
        >
          <Menu class="h-3.5 w-3.5 opacity-50" />
        </button>
      </div>
    </nav>
  </Section>
</header>
