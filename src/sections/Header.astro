---
import Backdrop from "@components/Backdrop.astro";
import Section from "@components/Section.astro";

import Logo from "@assets/astro.svg";
import Moon from "@icons/moon.svg";
import Sun from "@icons/sun.svg";

interface Props {
  title: string;
  href: string;
}

const NAV_ITEMS: Props[] = [
  { title: "Home", href: "/" },
  { title: "About", href: "#about" },
  { title: "Projects", href: "#projects" },
  { title: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-0 w-full border-b border-slate-200 dark:border-slate-600"
>
  <Backdrop />
  <Section class="flex-row items-center justify-between py-2">
    <Logo />
    <nav class="flex items-center">
      <ul id="menu" class="flex items-center">
        {
          NAV_ITEMS.map(({ title, href }) => (
            <li>
              <a class="px-3 py-2" href={href}>
                {title}
              </a>
            </li>
          ))
        }
      </ul>
      <div>
        <button
          id="theme-toggle"
          class="cursor-pointer p-2"
          name="toggle theme"
          type="button"
        >
          <Sun class="hidden h-6 w-6 dark:block" />
          <Moon class="block h-6 w-6 dark:hidden" />
        </button>
      </div>
    </nav>
  </Section>
</header>
